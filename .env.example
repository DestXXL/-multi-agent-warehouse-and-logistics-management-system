# Server only. Copy to .env and fill locally. Never use VITE_ for a secret.
LLM_API_KEY=
LLM_PROVIDER=KodikRouter
LLM_BASE_URL=https://api.kodikrouter.ru/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# Comma separated model IDs enabled by your provider and account.
LLM_MODELS=deepseek/deepseek-v4.1-flash-1017
LLM_MAX_TOKENS=900
LLM_TIMEOUT=10
LLM_REQUEST_LIMIT=50
LLM_TOKEN_LIMIT=50000
LLM_JSON_MODE=true
# Leave unset to use provider defaults.
# LLM_TEMPERATURE=0.2
# Legacy KODIKROUTER_API_KEY is also supported when LLM_API_KEY is unset.
